<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Custom Wallpaper -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/wallpaper_custom"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wallpaper_scrim" />

    <!-- Full screen hint (Apple TV style: Chevron + "Swipe up for full screen") -->
    <LinearLayout
        android:id="@+id/fullScreenHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="200dp"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="8dp"
            android:src="@drawable/ic_chevron_up"
            android:tint="#D0FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Swipe up for full screen"
            android:textColor="#D0FFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="22dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Top Right Apple TV Style Unified Capsule Bar -->
            <LinearLayout
                android:id="@+id/topCapsuleBar"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:gravity="center_vertical"
                android:background="@drawable/capsule_bar_bg"
                android:orientation="horizontal">

                <!-- 1. Time -->
                <TextView
                    android:id="@+id/capsuleClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <!-- Dot Divider -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="•"
                    android:textColor="#80FFFFFF"
                    android:textSize="12sp" />

                <!-- 2. Date -->
                <TextView
                    android:id="@+id/capsuleDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

                <!-- Vertical Bar Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="10dp"
                    android:background="#33FFFFFF" />

                <!-- 3. Control Center Toggle Button -->
                <FrameLayout
                    android:id="@+id/btnControlCenterToggle"
                    android:layout_width="38dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/capsule_tab_toggle_bg"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:nextFocusRight="@+id/btnProfileAvatar"
                    android:nextFocusDown="@+id/grid">

                    <ImageView
                        android:id="@+id/iconToggle"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_cc_toggle"
                        android:tint="@drawable/capsule_icon_tint"
                        android:duplicateParentState="true" />
                </FrameLayout>

                <!-- Vertical Bar Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="12dp"
                    android:background="#33FFFFFF" />

                <!-- 4. User Greeting ("Olá, João") -->
                <TextView
                    android:id="@+id/capsuleUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="Olá, João"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <!-- 5. Profile Avatar Button -->
                <FrameLayout
                    android:id="@+id/btnProfileAvatar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:nextFocusLeft="@+id/btnControlCenterToggle"
                    android:nextFocusDown="@+id/grid">

                    <ImageView
                        android:id="@+id/pillAvatar"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/avatar_user"
                        android:scaleType="centerCrop" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/avatar_border" />
                </FrameLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Grid of apps -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="16dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>



    <!-- Scrim / Dimmer overlay for Control Center -->
    <View
        android:id="@+id/ccScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#45000000"
        android:visibility="gone"
        android:alpha="0"
        android:clickable="true"
        android:focusable="false" />

    <!-- Control Center: only actions that really work on the TV. -->
    <LinearLayout
        android:id="@+id/controlCenterPanel"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="56dp"
        android:padding="14dp"
        android:background="@drawable/balloon_panel_bg"
        android:orientation="vertical"
        android:elevation="20dp"
        android:visibility="gone"
        android:clipToPadding="false"
        android:clipChildren="false">

        <LinearLayout
            android:id="@+id/panelControlCenter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tileInputs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/balloon_item_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:nextFocusUp="@+id/btnControlCenterToggle"
                android:nextFocusRight="@+id/tileWifi"
                android:nextFocusDown="@+id/tileBluetooth">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_input"
                    android:tint="@color/balloon_icon_white"
                    android:duplicateParentState="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical"
                    android:duplicateParentState="true">

                <TextView
                    android:id="@+id/tileInputsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cc_inputs"
                    android:textColor="@color/balloon_text_title"
                    android:duplicateParentState="true"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileWifi"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/balloon_item_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:nextFocusUp="@+id/btnControlCenterToggle"
                android:nextFocusLeft="@+id/tileInputs"
                android:nextFocusDown="@+id/tileScreensaver">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_wifi"
                    android:tint="@color/balloon_icon_white"
                    android:duplicateParentState="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical"
                    android:duplicateParentState="true">

                <TextView
                    android:id="@+id/tileWifiTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wifi"
                    android:textColor="@color/balloon_text_title"
                    android:duplicateParentState="true"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true" />
                <TextView
                    android:id="@+id/tileWifiSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/balloon_text_sub"
                    android:duplicateParentState="true"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/tileBluetooth"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/balloon_item_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:nextFocusUp="@+id/tileInputs"
                android:nextFocusRight="@+id/tileScreensaver"
                android:nextFocusDown="@+id/tileSettings">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_bluetooth"
                    android:tint="@color/balloon_icon_white"
                    android:duplicateParentState="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical"
                    android:duplicateParentState="true">

                <TextView
                    android:id="@+id/tileBluetoothTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cc_bluetooth"
                    android:textColor="@color/balloon_text_title"
                    android:duplicateParentState="true"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileScreensaver"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/balloon_item_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:nextFocusUp="@+id/tileWifi"
                android:nextFocusLeft="@+id/tileBluetooth"
                android:nextFocusDown="@+id/tileAccessibility">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_moon"
                    android:tint="@color/balloon_icon_white"
                    android:duplicateParentState="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical"
                    android:duplicateParentState="true">

                <TextView
                    android:id="@+id/tileScreensaverTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cc_screensaver"
                    android:textColor="@color/balloon_text_title"
                    android:duplicateParentState="true"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/tileSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/balloon_item_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:nextFocusUp="@+id/tileBluetooth"
                android:nextFocusRight="@+id/tileAccessibility"
                android:nextFocusDown="@+id/tileSearch">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/balloon_icon_white"
                    android:duplicateParentState="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical"
                    android:duplicateParentState="true">

                <TextView
                    android:id="@+id/tileSettingsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings"
                    android:textColor="@color/balloon_text_title"
                    android:duplicateParentState="true"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileAccessibility"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/balloon_item_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:nextFocusUp="@+id/tileScreensaver"
                android:nextFocusLeft="@+id/tileSettings"
                android:nextFocusDown="@+id/tileSearch">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_accessibility"
                    android:tint="@color/balloon_icon_white"
                    android:duplicateParentState="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical"
                    android:duplicateParentState="true">

                <TextView
                    android:id="@+id/tileAccessibilityTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cc_accessibility"
                    android:textColor="@color/balloon_text_title"
                    android:duplicateParentState="true"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/tileSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/balloon_item_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:nextFocusUp="@+id/tileSettings"
                android:nextFocusRight="@+id/tileApps">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_search_mini"
                    android:tint="@color/balloon_icon_white"
                    android:duplicateParentState="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical"
                    android:duplicateParentState="true">

                <TextView
                    android:id="@+id/tileSearchTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cc_search"
                    android:textColor="@color/balloon_text_title"
                    android:duplicateParentState="true"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileApps"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/balloon_item_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:nextFocusUp="@+id/tileAccessibility"
                android:nextFocusLeft="@+id/tileSearch">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_av"
                    android:tint="@color/balloon_icon_white"
                    android:duplicateParentState="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical"
                    android:duplicateParentState="true">

                <TextView
                    android:id="@+id/tileAppsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cc_apps"
                    android:textColor="@color/balloon_text_title"
                    android:duplicateParentState="true"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
